# Copy this file to .env and fill in the values: cp .env.sample .env

# --- Django ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# --- PostgreSQL ---
POSTGRES_DB=clinic# Leave empty to use a local SQLite file instead
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram (admin notifications) ---
# Bot token from BotFather
TELEGRAM_BOT_TOKEN=token
# admin chat ID
TELEGRAM_CHAT_ID=ID

# --- Stripe ---
STRIPE_SECRET_KEY=stripe_key
STRIPE_PUBLISHABLE_KEY=another_key?
STRIPE_WEBHOOK_SECRET=
